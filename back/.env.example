# Copie para back/.env e preencha. O .env NÃO vai para o Git.
# Chave grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: trocar o modelo
# GEMINI_MODEL=gemini-3.1-flash-lite

# Login: o primeiro usuário é criado na subida a partir destes dois valores (só se o banco
# ainda não tiver nenhum usuário). Senha com pelo menos 10 caracteres.
ADMIN_USUARIO=admin
ADMIN_SENHA=
# Token que o simulador IoT/sensores mandam no header X-Dispositivo-Token para enviar leituras.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRIA_TOKEN=
# Opcional: documentação interativa da API em http://127.0.0.1:8000/docs
# API_DOCS=true
