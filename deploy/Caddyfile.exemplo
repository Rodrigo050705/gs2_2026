# Sites para o Caddyfile da VM "proxy" (192.168.0.3).
# Os nomes ficam um nível só abaixo de gtlabs.com.br (Universal SSL do Cloudflare).
# Uma porta por ambiente: o nginx do serviço "web" serve o front e repassa /api/ para a API.

# Homologação: atualizada a cada merge na main.
agrosmart-hml.gtlabs.com.br {
	reverse_proxy infra.home:8092
}

# Produção: atualizada pelo PR de versão (tag vX.Y.Z) no gtlabs-deploy.
agrosmart.gtlabs.com.br {
	reverse_proxy infra.home:8093
}
