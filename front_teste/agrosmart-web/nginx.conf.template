server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS interno do Docker: resolve o nome do serviço da API a cada requisição, então o
    # nginx sobe mesmo se a API ainda não estiver no ar (e acompanha um IP novo após restart).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    # API (FastAPI). O chat pode levar alguns segundos (troca de modelo de IA).
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 90s;
    }

    # Healthcheck do próprio container do front.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # SPA: qualquer outra rota cai no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
